// prisma/schema.prisma

generator client {
  provider = "prisma-client-js" // Corregido el nombre del provider estándar
}

datasource db {
  provider = "postgresql"
}

// --- IDENTIDAD ---
model User {
  id        Int      @id @default(autoincrement())
  cedula    String   @unique // Este es el 'userid' del biométrico
  fullName  String   @map("full_name")
  email     String   @unique
  password  String
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  // Relaciones
  branchOfficeId Int          @map("branch_office_id")
  branchOffice   BranchOffice @relation(fields: [branchOfficeId], references: [id])

  templates BiometricTemplate[]
  records   AttendanceRecord[]

  @@map("users")
}

// --- BIOMETRÍA ---
model BiometricTemplate {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  // Cifrado AES-256 para la data binaria de la huella
  encryptedData String @map("encrypted_data")
  encryptionIv  String @map("encryption_iv")
  fingerIndex   Int    @map("finger_index") // 0-9 para dedos

  qualityScore Int      @default(0) @map("quality_score")
  createdAt    DateTime @default(now()) @map("created_at")
  isDeleted    Boolean  @default(false) @map("is_deleted")

  // Quitamos @unique de cedula aquí porque un usuario puede tener varias huellas (dedos)
  @@unique([userId, fingerIndex])
  @@map("biometric_templates")
}

// --- HARDWARE ---
model BiometricDevice {
  id        Int          @id @default(autoincrement())
  name      String
  serial    String       @unique
  ip        String // Obligatoria para el Bridge
  port      Int          @default(4370)
  token     String?      @unique // Útil para WebSockets o APIs externas
  lastSync  DateTime?    @map("last_sync")
  status    DeviceStatus @default(OFFLINE)
  isDeleted Boolean      @default(false) @map("is_deleted")

  branchOfficeId Int          @map("branch_office_id")
  branchOffice   BranchOffice @relation(fields: [branchOfficeId], references: [id])

  records AttendanceRecord[]

  @@map("biometric_devices")
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

// --- ESTRUCTURA ORGANIZACIONAL ---
model Company {
  id        Int            @id @default(autoincrement())
  name      String
  isDeleted Boolean        @default(false) @map("is_deleted")
  branches  BranchOffice[]

  @@map("companies")
}

model BranchOffice {
  id        Int     @id @default(autoincrement())
  name      String
  isDeleted Boolean @default(false) @map("is_deleted")

  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  users   User[]
  devices BiometricDevice[]

  @@map("branch_offices")
}

// --- REGISTROS DE ASISTENCIA ---
model AttendanceRecord {
  id        Int             @id @default(autoincrement())
  userId    Int             @map("user_id")
  user      User            @relation(fields: [userId], references: [id])
  deviceId  Int             @map("device_id")
  device    BiometricDevice @relation(fields: [deviceId], references: [id])
  timestamp DateTime        @default(now())

  // --- EL CAMBIO MÁS IMPORTANTE ---
  // Evita que el mismo usuario marque en el mismo segundo en el mismo dispositivo.
  // Esto protege tu base de datos de los "dobles clics" en el lector.
  @@unique([userId, timestamp, deviceId])
  @@map("attendance_records")
}
